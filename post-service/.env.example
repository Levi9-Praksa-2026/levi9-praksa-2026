# Copy to .env.local to run PostServiceApplication from the IDE (load it as an env file in the run configuration).
# Needs Postgres from docker compose (docker compose up -d postgres) and a Moto container on port 5000
# (docker run -d --name moto-local -p 5000:5000 motoserver/moto:5.2.5). Local values only, never commit .env.local.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/reddit
SPRING_DATASOURCE_USERNAME=reddit
SPRING_DATASOURCE_PASSWORD=reddit_local
APP_MOCKAUTH_ENABLED=true
APP_COMMUNITYSTUB_ENABLED=true
APP_COMMUNITYSTUB_UNAVAILABLECOMMUNITYIDS=999
APP_COMMUNITYSTUB_NONMEMBERUSERIDS=999
APP_S3_ENDPOINT=http://localhost:5000
